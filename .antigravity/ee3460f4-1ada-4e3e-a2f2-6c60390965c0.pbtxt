  file_change {
    absolute_path_uri: "file:///src/components/ProfileView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React from \'react\';\nimport { useVanity } from \'../context/VanityContext\';\n\nexport const ProfileView: React.FC = () => {\n  const {\n    user,\n    isGuest,\n    loginWithGoogle,\n    logout,\n    products,\n    brands,\n    showToast,\n  } = useVanity();\n\n  const totalProducts = products.length;\n  const favoriteCount = products.filter((p) => p.isFavorite).length;\n  const outOfStockCount = products.filter(\n    (p) => p.status === \'agotado\' || p.status === \'por_reponer\'\n  ).length;\n\n  const handleExportData = () => {\n    const backup = {\n      exportedAt: new Date().toISOString(),\n      products,\n      brands,\n    };\n    const dataStr = \'data:text/json;charset=utf-8,\' + encodeURIComponent(JSON.stringify(backup, null, 2));\n    const downloadAnchor = document.createElement(\'a\');\n    downloadAnchor.setAttribute(\'href\', dataStr);\n    downloadAnchor.setAttribute(\'download\', `vanity_backup_${new Date().toISOString().slice(0, 10)}.json`);\n    document.body.appendChild(downloadAnchor);\n    downloadAnchor.click();\n    downloadAnchor.remove();\n    showToast(\'Copia de seguridad descargada exitosamente\');\n  };\n\n  return (\n    <div className=\"flex flex-col w-full pb-28 space-y-5\">\n      {/* Encabezado */}\n      <div className=\"flex flex-col space-y-1\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#fee1e4] text-[#9c385b] text-[11px] font-bold w-fit shadow-sm uppercase tracking-wider\">\n          <span className=\"material-symbols-outlined text-[14px]\">person</span>\n          <span>MI ESPACIO & SEGURIDAD</span>\n        </div>\n\n        <h1 className=\"font-headline text-[30px] font-semibold text-[#261819] leading-tight\">\n          Perfil de Belleza\n        </h1>\n        <p className=\"text-[13.5px] text-[#554246]\">\n          Gestiona tu cuenta, sincronizaci\303\263n en la nube con Firebase y estad\303\255sticas de tu tocador.\n        </p>\n      </div>\n\n      {/* Tarjeta de Usuario & Autenticaci\303\263n Firebase */}\n      <div className=\"p-5 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-4\">\n        <div className=\"flex items-center gap-4\">\n          <div className=\"relative\">\n            <img\n              src={\n                user?.photoURL ||\n                \'https://lh3.googleusercontent.com/aida-public/AB6AXuBqmhkchV3JUBDu8vFUodavOCCVHNymhhfU4aSG3QQOGXjE-8mwTcs8z0FOccTE4eeiyeBvRhqYigj5E8vMWMkOMhjUfeO12nEBW_Mh3FLufFy3_1idNvAmgowIiXULR73udPHz9dn3mpqGwfTJrQiLHqGgAWJc7HxbEMViD2g6mrnTj83s56T2cn7vEdADLuBLmIo-1rJgrAaXaM6J6ggw6Zu6d1bpA7cxfacYsbcM3b8lFCAeGzVrYA\'\n              }\n              alt=\"Avatar\"\n              className=\"w-16 h-16 rounded-full object-cover ring-2 ring-[#9c385b]/30 shadow-md\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <span className=\"absolute bottom-0 right-0 w-5 h-5 rounded-full bg-[#9c385b] text-white flex items-center justify-center text-[10px] shadow-sm\">\n              <span className=\"material-symbols-outlined text-[12px]\">verified</span>\n            </span>\n          </div>\n\n          <div className=\"flex flex-col flex-1\">\n            <h2 className=\"font-headline text-[20px] font-semibold text-[#261819] leading-tight\">\n              {user?.displayName || \'Sof\303\255a Valenzuela\'}\n            </h2>\n            <span className=\"text-[12px] text-[#554246]\">\n              {user?.email || \'sofia.valenzuela@vanity.beauty\'}\n            </span>\n            <div className=\"flex items-center gap-1.5 mt-1.5\">\n              <span\n                className={`w-2 h-2 rounded-full ${\n                  user ? \'bg-emerald-500 animate-pulse\' : \'bg-amber-500\'\n                }`}\n              ></span>\n              <span className=\"text-[11px] font-bold text-[#79542b]\">\n                {user ? \'Sincronizado con Firebase\' : \'Modo Local / Invitado\'}\n              </span>\n            </div>\n          </div>\n        </div>\n\n        {/* Bot\303\263n Iniciar Sesi\303\263n con Google o Cerrar Sesi\303\263n */}\n        {user ? (\n          <div className=\"pt-2 flex items-center justify-between border-t border-[#dac0c5]/25\">\n            <span className=\"text-[12px] text-[#554246] font-medium\">\n              Conectado a Firebase Auth\n            </span>\n            <button\n              onClick={logout}\n              className=\"px-4 py-2 rounded-full bg-[#fee1e4] hover:bg-[#f8dcde] text-[#ba1a1a] text-[12px] font-bold transition-all active:scale-95\"\n            >\n              Cerrar Sesi\303\263n\n            </button>\n          </div>\n        ) : (\n          <div className=\"pt-2 border-t border-[#dac0c5]/25 space-y-2\">\n            <p className=\"text-[12px] text-[#554246]\">\n              Inicia sesi\303\263n con Google para respaldar tus productos, marcas e im\303\241genes en la nube de Firebase Firestore de manera segura.\n            </p>\n            <button\n              onClick={loginWithGoogle}\n              className=\"w-full h-12 rounded-2xl bg-[#9c385b] hover:bg-[#852a4a] text-white font-bold text-[14px] flex items-center justify-center gap-2.5 shadow-sm active:scale-95 transition-all\"\n            >\n              <svg className=\"w-4 h-4 fill-current\" viewBox=\"0 0 24 24\">\n                <path d=\"M12.24 10.285V14.4h6.806c-.275 1.765-2.056 5.174-6.806 5.174-4.095 0-7.439-3.389-7.439-7.574s3.344-7.574 7.439-7.574c2.33 0 3.891.989 4.785 1.849l3.254-3.138C18.189 1.186 15.479 0 12.24 0c-6.635 0-12 5.365-12 12s5.365 12 12 12c6.926 0 11.52-4.869 11.52-11.726 0-.788-.085-1.39-.189-1.989H12.24z\" />\n              </svg>\n              <span>Acceder con Google</span>\n            </button>\n          </div>\n        )}\n      </div>\n\n      {/* M\303\251tricas del Tocador */}\n      <div className=\"space-y-2\">\n        <h3 className=\"font-headline text-[18px] font-semibold text-[#261819] px-1\">\n          Resumen de tu Colecci\303\263n\n        </h3>\n\n        <div className=\"grid grid-cols-2 gap-3\">\n          <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n            <span className=\"text-[11px] font-bold text-[#9c385b] uppercase\">COSM\303\211TICOS</span>\n            <span className=\"font-headline text-[28px] font-bold text-[#261819] leading-tight\">\n              {totalProducts}\n            </span>\n            <span className=\"text-[11.5px] text-[#554246]\">Tesoros registrados</span>\n          </div>\n\n          <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n            <span className=\"text-[11px] font-bold text-[#79542b] uppercase\">MARCAS</span>\n            <span className=\"font-headline text-[28px] font-bold text-[#261819] leading-tight\">\n              {brands.length}\n            </span>\n            <span className=\"text-[11.5px] text-[#554246]\">Firmas en colecci\303\263n</span>\n          </div>\n\n          <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n            <span className=\"text-[11px] font-bold text-[#9c385b] uppercase\">FAVORITOS</span>\n            <span className=\"font-headline text-[28px] font-bold text-[#261819] leading-tight\">\n              {favoriteCount}\n            </span>\n            <span className=\"text-[11.5px] text-[#554246]\">F\303\263rmulas predilectas</span>\n          </div>\n\n          <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n            <span className=\"text-[11px] font-bold text-[#ba1a1a] uppercase\">POR REPONER</span>\n            <span className=\"font-headline text-[28px] font-bold text-[#ba1a1a] leading-tight\">\n              {outOfStockCount}\n            </span>\n            <span className=\"text-[11.5px] text-[#554246]\">Productos agotados</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Control de Seguridad & Copia de Respaldo */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <div className=\"flex items-center gap-2 text-[#79542b]\">\n          <span className=\"material-symbols-outlined text-[20px]\">cloud_done</span>\n          <span className=\"font-bold text-[13px]\">Almacenamiento & Respaldos</span>\n        </div>\n        <p className=\"text-[12px] text-[#554246]\">\n          Tus datos se guardan de forma persistente y segura en Firebase Firestore y en tu dispositivo local. Puedes exportar una copia en cualquier momento.\n        </p>\n\n        <button\n          onClick={handleExportData}\n          className=\"w-full h-11 rounded-2xl bg-[#fee1e4] hover:bg-[#f8dcde] text-[#261819] font-bold text-[13px] flex items-center justify-center gap-2 transition-all active:scale-95 shadow-sm\"\n        >\n          <span className=\"material-symbols-outlined text-[#9c385b] text-[18px]\">download</span>\n          <span>Exportar Copia de Seguridad JSON</span>\n        </button>\n      </div>\n    </div>\n  );\n};\n"
