  file_change {
    absolute_path_uri: "file:///src/components/AddProductView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState, useRef } from \'react\';\nimport { motion } from \'motion/react\';\nimport { useVanity } from \'../context/VanityContext\';\nimport { PRESET_SHADE_COLORS } from \'../data/initialData\';\nimport { Product } from \'../types\';\n\nexport const AddProductView: React.FC = () => {\n  const {\n    brands,\n    addProduct,\n    updateProduct,\n    editingProduct,\n    setEditingProduct,\n    setCurrentTab,\n    setIsAddBrandModalOpen,\n    showToast,\n  } = useVanity();\n\n  const fileInputRef = useRef<HTMLInputElement>(null);\n\n  // Form states\n  const [selectedBrand, setSelectedBrand] = useState<string>(\n    editingProduct?.brandName || (brands[0]?.name || \'Rare Beauty\')\n  );\n  const [productName, setProductName] = useState<string>(\n    editingProduct?.name || \'\'\n  );\n  const [reference, setReference] = useState<string>(\n    editingProduct?.reference || `#RB${Math.floor(1000 + Math.random() * 9000)}`\n  );\n  const [category, setCategory] = useState<string>(\n    editingProduct?.category || \'rubor\'\n  );\n  const [shadeName, setShadeName] = useState<string>(\n    editingProduct?.shadeName || \'#140 \342\200\242 Happy\'\n  );\n  const [shadeColor, setShadeColor] = useState<string>(\n    editingProduct?.shadeColor || \'#E58C96\'\n  );\n  const [finish, setFinish] = useState<string>(\n    editingProduct?.finish || \'Dewy\'\n  );\n  const [imageUrl, setImageUrl] = useState<string>(\n    editingProduct?.imageUrl ||\n      \'https://lh3.googleusercontent.com/aida-public/AB6AXuA9uRXvdw7dEvDzVv60CSWQ8iSCooAMXrz1qFJm_iqWwC_cfVNnidAJobkiKxRofSg7Tu6GwGtzKpHZXToFUJikvIJ-_bX3JjHBvpyqO8azYZuBM-ilvVhwfkaLUgQVuK9S2wocHZCLq48xVqnPiCXb5lot7-pXtvpoOUl4uAlbVFjNkRDRejI8eiuYlbIYlaYMKb9esemzlSlRerFeYES55JlNFEo0jqESR2yK6gUNVxxezZike34WmA\'\n  );\n  const [paoMonths, setPaoMonths] = useState<number>(\n    editingProduct?.paoMonths || 12\n  );\n  const [location, setLocation] = useState<string>(\n    editingProduct?.location || \'Caj\303\263n superior / Uso diario\'\n  );\n  const [notes, setNotes] = useState<string>(\n    editingProduct?.personalNotes || \'\'\n  );\n\n  const [customBrandInput, setCustomBrandInput] = useState<string>(selectedBrand);\n  const [isUploading, setIsUploading] = useState<boolean>(false);\n\n  // File upload handler\n  const handleFileUpload = (e: React.ChangeEvent<HTMLInputElement>) => {\n    const file = e.target.files?.[0];\n    if (!file) return;\n\n    setIsUploading(true);\n    const reader = new FileReader();\n    reader.onload = (event) => {\n      if (event.target?.result) {\n        setImageUrl(event.target.result as string);\n        showToast(\'Foto cargada exitosamente\');\n      }\n      setIsUploading(false);\n    };\n    reader.readAsDataURL(file);\n  };\n\n  const handleCameraCapture = () => {\n    // Triggers file picker with capture camera constraint\n    if (fileInputRef.current) {\n      fileInputRef.current.click();\n    }\n  };\n\n  const handleSave = async () => {\n    if (!productName.trim()) {\n      showToast(\'Por favor introduce el nombre del producto\');\n      return;\n    }\n\n    const brandNameToSave = customBrandInput.trim() || selectedBrand;\n\n    if (editingProduct) {\n      await updateProduct(editingProduct.id, {\n        name: productName,\n        brandName: brandNameToSave,\n        reference,\n        category,\n        shadeName,\n        shadeColor,\n        finish,\n        imageUrl,\n        paoMonths: Number(paoMonths),\n        location,\n        personalNotes: notes,\n      });\n      setEditingProduct(null);\n    } else {\n      await addProduct({\n        name: productName,\n        brandName: brandNameToSave,\n        reference,\n        category,\n        subCategory: category.charAt(0).toUpperCase() + category.slice(1),\n        shadeName,\n        shadeColor,\n        finish,\n        imageUrl,\n        status: \'en_uso\',\n        size: \'3.2 ml\',\n        isFavorite: true,\n        paoMonths: Number(paoMonths),\n        purchaseDate: new Date().toLocaleDateString(\'es-ES\', {\n          day: \'2-digit\',\n          month: \'short\',\n          year: \'numeric\',\n        }),\n        location,\n        personalNotes: notes,\n      });\n    }\n\n    setCurrentTab(\'tocador\');\n  };\n\n  const CATEGORY_OPTIONS = [\n    { id: \'rubor\', label: \'Rubor\', icon: \'local_florist\' },\n    { id: \'base\', label: \'Base\', icon: \'face_3\' },\n    { id: \'labial\', label: \'Labial\', icon: \'qr_code_2\' },\n    { id: \'pestanas\', label: \'Pesta\303\261ina\', icon: \'visibility\' },\n    { id: \'sombras\', label: \'Sombras\', icon: \'palette\' },\n    { id: \'polvos\', label: \'Polvos\', icon: \'grain\' },\n  ];\n\n  return (\n    <div className=\"flex flex-col w-full pb-28 space-y-5\">\n      {/* Encabezado Editorial */}\n      <div className=\"flex flex-col space-y-1\">\n        <div className=\"inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#fee1e4] text-[#9c385b] text-[11px] font-bold w-fit shadow-sm uppercase tracking-wider\">\n          <span className=\"material-symbols-outlined text-[14px]\">auto_awesome</span>\n          <span>MI COLECCI\303\223N PERSONAL</span>\n        </div>\n\n        <h1 className=\"font-headline text-[32px] font-semibold text-[#261819] leading-tight flex items-center gap-2\">\n          <span>{editingProduct ? \'Editar Producto\' : \'Nuevo Producto\'}</span>\n          <span className=\"text-[#d4a574]\">\342\234\250</span>\n        </h1>\n\n        <p className=\"text-[13.5px] text-[#554246] leading-relaxed\">\n          A\303\261ade un nuevo tesoro a tu tocador y mant\303\251n su vida \303\272til bajo control.\n        </p>\n      </div>\n\n      {/* Tarjeta Fotogr\303\241fica: Retrato de tu joya */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3.5 text-center\">\n        {imageUrl ? (\n          <div className=\"relative w-full aspect-video rounded-2xl overflow-hidden bg-[#fff0f1] border border-[#dac0c5]/25 group\">\n            <img\n              src={imageUrl}\n              alt=\"Preview joya\"\n              className=\"w-full h-full object-cover\"\n              referrerPolicy=\"no-referrer\"\n            />\n            <div className=\"absolute inset-0 bg-[#261819]/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center gap-2\">\n              <button\n                type=\"button\"\n                onClick={() => fileInputRef.current?.click()}\n                className=\"px-3 py-1.5 rounded-full bg-white text-[#261819] text-[12px] font-bold shadow-md\"\n              >\n                Cambiar Imagen\n              </button>\n            </div>\n          </div>\n        ) : (\n          <div className=\"p-6 rounded-2xl bg-[#fee1e4]/40 border border-[#dac0c5]/30 flex flex-col items-center justify-center space-y-2\">\n            <div className=\"w-14 h-14 rounded-full bg-[#fee1e4] text-[#9c385b] flex items-center justify-center shadow-inner\">\n              <span className=\"material-symbols-outlined text-[28px]\">photo_camera</span>\n            </div>\n            <span className=\"font-headline text-[17px] font-semibold text-[#261819]\">\n              Retrato de tu joya\n            </span>\n            <p className=\"text-[12px] text-[#554246] max-w-xs\">\n              Captura el envase o el swatch para identificarlo con elegancia\n            </p>\n          </div>\n        )}\n\n        {/* Input oculto para carga de archivos */}\n        <input\n          ref={fileInputRef}\n          type=\"file\"\n          accept=\"image/*\"\n          className=\"hidden\"\n          onChange={handleFileUpload}\n        />\n\n        {/* Botones C\303\241mara y Galer\303\255a */}\n        <div className=\"grid grid-cols-2 gap-3 pt-1\">\n          <button\n            type=\"button\"\n            onClick={handleCameraCapture}\n            className=\"h-11 rounded-2xl bg-[#fee1e4] hover:bg-[#f8dcde] text-[#261819] text-[13px] font-bold flex items-center justify-center gap-2 transition-all active:scale-95 shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-[#9c385b] text-[20px]\">\n              photo_camera\n            </span>\n            <span>C\303\241mara ...</span>\n          </button>\n\n          <button\n            type=\"button\"\n            onClick={() => fileInputRef.current?.click()}\n            className=\"h-11 rounded-2xl bg-[#fee1e4] hover:bg-[#f8dcde] text-[#261819] text-[13px] font-bold flex items-center justify-center gap-2 transition-all active:scale-95 shadow-sm\"\n          >\n            <span className=\"material-symbols-outlined text-[#9c385b] text-[20px]\">\n              photo_library\n            </span>\n            <span>Galer\303\255a ...</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Secci\303\263n Marca */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <label className=\"text-[13px] font-bold text-[#261819]\">Marca</label>\n          <span className=\"text-[11px] font-bold text-[#9c385b]\">Obligatorio</span>\n        </div>\n\n        {/* Chips de Marcas */}\n        <div className=\"flex items-center gap-2 overflow-x-auto no-scrollbar pb-1\">\n          <button\n            type=\"button\"\n            onClick={() => setIsAddBrandModalOpen(true)}\n            className=\"px-3 py-1.5 rounded-full bg-[#fee1e4] text-[#261819] text-[12px] font-bold flex items-center gap-1 flex-shrink-0 active:scale-95 hover:bg-[#f8dcde]\"\n          >\n            <span className=\"material-symbols-outlined text-[16px] text-[#9c385b]\">add</span>\n            <span>+ Nueva Marca</span>\n          </button>\n\n          {brands.map((b) => {\n            const isSelected = selectedBrand.toLowerCase() === b.name.toLowerCase();\n            return (\n              <button\n                key={b.id}\n                type=\"button\"\n                onClick={() => {\n                  setSelectedBrand(b.name);\n                  setCustomBrandInput(b.name);\n                }}\n                className={`px-3.5 py-1.5 rounded-full text-[12px] font-bold flex items-center gap-1.5 flex-shrink-0 transition-all active:scale-95 ${\n                  isSelected\n                    ? \'bg-[#8e4a53] text-white shadow-sm\'\n                    : \'bg-[#fee1e4]/50 text-[#554246] hover:bg-[#fee1e4]\'\n                }`}\n              >\n                <span className=\"w-2 h-2 rounded-full bg-current opacity-70\"></span>\n                <span>{b.name}</span>\n              </button>\n            );\n          })}\n        </div>\n\n        {/* Input nombre de marca */}\n        <div className=\"h-12 px-3.5 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center gap-2\">\n          <input\n            value={customBrandInput}\n            onChange={(e) => {\n              setCustomBrandInput(e.target.value);\n              setSelectedBrand(e.target.value);\n            }}\n            placeholder=\"Nombre de la marca (ej. Rare Beauty)\"\n            className=\"w-full bg-transparent text-[14px] text-[#261819] font-medium outline-none placeholder:text-[#877176]/70\"\n          />\n        </div>\n      </div>\n\n      {/* Secci\303\263n Producto & Referencia */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <label className=\"text-[13px] font-bold text-[#261819]\">Producto & Referencia</label>\n\n        <div className=\"h-12 px-3.5 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n          <input\n            value={productName}\n            onChange={(e) => setProductName(e.target.value)}\n            placeholder=\"Ej. Soft Pinch Liquid Blush\"\n            className=\"w-full bg-transparent text-[14px] text-[#261819] font-medium outline-none placeholder:text-[#877176]/70\"\n          />\n        </div>\n\n        <div className=\"h-12 px-3.5 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n          <input\n            value={reference}\n            onChange={(e) => setReference(e.target.value)}\n            placeholder=\"Ref: #RB8921 o Lote\"\n            className=\"w-full bg-transparent text-[13px] text-[#554246] font-medium outline-none placeholder:text-[#877176]/70\"\n          />\n        </div>\n      </div>\n\n      {/* Secci\303\263n Categor\303\255a */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <label className=\"text-[13px] font-bold text-[#261819]\">Categor\303\255a</label>\n          <span className=\"text-[11px] text-[#554246] font-medium\">Tipo de producto</span>\n        </div>\n\n        {/* Grid de Selecci\303\263n */}\n        <div className=\"grid grid-cols-3 gap-2.5\">\n          {CATEGORY_OPTIONS.map((cat) => {\n            const isSelected = category === cat.id;\n            return (\n              <button\n                key={cat.id}\n                type=\"button\"\n                onClick={() => setCategory(cat.id)}\n                className={`py-3 px-2 rounded-2xl flex flex-col items-center justify-center gap-1.5 transition-all active:scale-95 border ${\n                  isSelected\n                    ? \'bg-[#fee1e4] border-[#9c385b] shadow-sm text-[#9c385b]\'\n                    : \'bg-[#fff0f1] border-transparent text-[#554246] hover:bg-[#fee1e4]/50\'\n                }`}\n              >\n                <span className=\"material-symbols-outlined text-[22px]\">{cat.icon}</span>\n                <span className=\"text-[12px] font-bold\">{cat.label}</span>\n              </button>\n            );\n          })}\n\n          <button\n            type=\"button\"\n            onClick={() => {\n              const custom = prompt(\'Introduce nueva categor\303\255a:\');\n              if (custom) {\n                setCategory(custom.toLowerCase());\n                showToast(`Categor\303\255a \"${custom}\" seleccionada`);\n              }\n            }}\n            className=\"py-3 px-2 rounded-2xl border-2 border-dashed border-[#dac0c5] bg-[#fff8f7] text-[#9c385b] flex flex-col items-center justify-center gap-1 active:scale-95\"\n          >\n            <span className=\"material-symbols-outlined text-[20px]\">add</span>\n            <span className=\"text-[11px] font-bold\">+ Nueva</span>\n          </button>\n        </div>\n      </div>\n\n      {/* Secci\303\263n Tono / Shade */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <div className=\"flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <label className=\"text-[13px] font-bold text-[#261819]\">Tono / Shade</label>\n            <span className=\"px-2 py-0.5 rounded-full bg-[#fee1e4] text-[#9c385b] text-[10px] font-bold uppercase\">\n              Opcional\n            </span>\n          </div>\n\n          <div className=\"flex items-center gap-1.5 px-2.5 py-1 rounded-full bg-[#fff0f1]\">\n            <span\n              className=\"w-3.5 h-3.5 rounded-full border border-white shadow-sm\"\n              style={{ backgroundColor: shadeColor }}\n            ></span>\n            <span className=\"text-[11px] font-bold text-[#261819] truncate max-w-[90px]\">\n              {shadeName}\n            </span>\n          </div>\n        </div>\n\n        {/* Input nombre de tono */}\n        <div className=\"h-12 px-3.5 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n          <input\n            value={shadeName}\n            onChange={(e) => setShadeName(e.target.value)}\n            placeholder=\"Ej. #140 \342\200\242 Happy\"\n            className=\"w-full bg-transparent text-[14px] text-[#261819] font-medium outline-none\"\n          />\n        </div>\n\n        {/* Selector de color r\303\241pido */}\n        <div className=\"space-y-2 pt-1\">\n          <span className=\"text-[11.5px] text-[#554246] font-medium\">\n            O elige un color aproximado:\n          </span>\n\n          <div className=\"flex items-center justify-between gap-1 flex-wrap\">\n            {PRESET_SHADE_COLORS.map((preset) => {\n              const isSelected = shadeColor.toLowerCase() === preset.hex.toLowerCase();\n              return (\n                <button\n                  key={preset.hex}\n                  type=\"button\"\n                  onClick={() => setShadeColor(preset.hex)}\n                  title={preset.name}\n                  className={`w-9 h-9 rounded-full transition-transform active:scale-90 border-2 ${\n                    isSelected\n                      ? \'border-[#9c385b] scale-110 shadow-md ring-2 ring-[#fda7b0]\'\n                      : \'border-white shadow-sm\'\n                  }`}\n                  style={{ backgroundColor: preset.hex }}\n                ></button>\n              );\n            })}\n          </div>\n\n          {/* Selector HEX Manual */}\n          <div className=\"grid grid-cols-2 gap-2 pt-2\">\n            <div className=\"h-11 px-3 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center gap-2\">\n              <span className=\"text-[11px] font-bold text-[#877176]\">HEX</span>\n              <input\n                type=\"text\"\n                value={shadeColor}\n                onChange={(e) => setShadeColor(e.target.value)}\n                className=\"w-full bg-transparent text-[12px] font-bold text-[#261819] outline-none\"\n              />\n            </div>\n\n            <label className=\"h-11 px-3 rounded-2xl bg-[#fee1e4] hover:bg-[#f8dcde] text-[#261819] text-[12px] font-bold flex items-center justify-center gap-1.5 cursor-pointer shadow-sm\">\n              <span\n                className=\"w-4 h-4 rounded-md shadow-sm border border-white\"\n                style={{ backgroundColor: shadeColor }}\n              ></span>\n              <span>Paleta HEX</span>\n              <span className=\"material-symbols-outlined text-[16px] text-[#9c385b]\">\n                colorize\n              </span>\n              <input\n                type=\"color\"\n                value={shadeColor}\n                onChange={(e) => setShadeColor(e.target.value)}\n                className=\"hidden\"\n              />\n            </label>\n          </div>\n        </div>\n      </div>\n\n      {/* Detalles Adicionales: PAO, Acabado, Ubicaci\303\263n & Notas */}\n      <div className=\"p-4 rounded-3xl bg-white border border-[#dac0c5]/30 shadow-sm space-y-3\">\n        <label className=\"text-[13px] font-bold text-[#261819]\">Vida \303\232til & Tocador</label>\n\n        <div className=\"grid grid-cols-2 gap-2.5\">\n          <div className=\"flex flex-col gap-1\">\n            <span className=\"text-[11px] text-[#877176] font-semibold\">PAO (Meses)</span>\n            <div className=\"h-11 px-3 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n              <input\n                type=\"number\"\n                value={paoMonths}\n                onChange={(e) => setPaoMonths(Number(e.target.value))}\n                className=\"w-full bg-transparent text-[13px] font-bold text-[#261819] outline-none\"\n              />\n            </div>\n          </div>\n\n          <div className=\"flex flex-col gap-1\">\n            <span className=\"text-[11px] text-[#877176] font-semibold\">Acabado</span>\n            <div className=\"h-11 px-3 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n              <input\n                type=\"text\"\n                value={finish}\n                onChange={(e) => setFinish(e.target.value)}\n                placeholder=\"Dewy, Matte, Glow...\"\n                className=\"w-full bg-transparent text-[13px] font-bold text-[#261819] outline-none\"\n              />\n            </div>\n          </div>\n        </div>\n\n        <div className=\"flex flex-col gap-1\">\n          <span className=\"text-[11px] text-[#877176] font-semibold\">Ubicaci\303\263n</span>\n          <div className=\"h-11 px-3 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 flex items-center\">\n            <input\n              type=\"text\"\n              value={location}\n              onChange={(e) => setLocation(e.target.value)}\n              placeholder=\"Caj\303\263n superior / Uso diario\"\n              className=\"w-full bg-transparent text-[13px] text-[#261819] font-medium outline-none\"\n            />\n          </div>\n        </div>\n\n        <div className=\"flex flex-col gap-1\">\n          <span className=\"text-[11px] text-[#877176] font-semibold\">Notas Personales</span>\n          <textarea\n            value={notes}\n            onChange={(e) => setNotes(e.target.value)}\n            rows={2}\n            placeholder=\"Consejos de aplicaci\303\263n, textura y duraci\303\263n...\"\n            className=\"w-full p-3 rounded-2xl bg-[#fff0f1] border border-[#dac0c5]/25 text-[13px] text-[#261819] outline-none resize-none\"\n          ></textarea>\n        </div>\n      </div>\n\n      {/* Botones de Acci\303\263n Finales */}\n      <div className=\"pt-2 space-y-2.5\">\n        <button\n          type=\"button\"\n          onClick={handleSave}\n          className=\"w-full h-13 rounded-2xl bg-[#8e4a53] hover:bg-[#793942] text-white font-bold text-[15px] flex items-center justify-center gap-2 shadow-md active:scale-95 transition-all\"\n        >\n          <span\n            className=\"material-symbols-outlined text-[20px]\"\n            style={{ fontVariationSettings: \"\'FILL\' 1\" }}\n          >\n            favorite\n          </span>\n          <span>{editingProduct ? \'Actualizar Producto\' : \'Guardar Producto\'}</span>\n        </button>\n\n        <button\n          type=\"button\"\n          onClick={() => {\n            setEditingProduct(null);\n            setCurrentTab(\'tocador\');\n          }}\n          className=\"w-full h-11 text-center font-semibold text-[14px] text-[#554246] hover:text-[#261819] transition-colors\"\n        >\n          Cancelar\n        </button>\n      </div>\n    </div>\n  );\n};\n"
    }
    diff {
