 \"name\"]\n    },\n    \"Product\": {\n      \"title\": \"Product\",\n      \"description\": \"Cosmetic product in the user vanity\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"id\": {\n          \"type\": \"string\",\n          \"description\": \"Unique identifier for product\"\n        },\n        \"userId\": {\n          \"type\": \"string\",\n          \"description\": \"Owner user ID\"\n        },\n        \"brandId\": {\n          \"type\": \"string\",\n          \"description\": \"Associated brand identifier\"\n        },\n        \"brandName\": {\n          \"type\": \"string\",\n          \"maxLength\": 100,\n          \"description\": \"Brand name\"\n        },\n        \"name\": {\n          \"type\": \"string\",\n          \"maxLength\": 120,\n          \"description\": \"Product name\"\n        },\n        \"category\": {\n          \"type\": \"string\",\n          \"maxLength\": 50,\n          \"description\": \"Category like Rubor, Labial, Base, etc.\"\n        },\n        \"subCategory\": {\n          \"type\": \"string\",\n          \"maxLength\": 80,\n          \"description\": \"Specific subcategory like Colorete L\303\255quido\"\n        },\n        \"shadeName\": {\n          \"type\": \"string\",\n          \"maxLength\": 100,\n          \"description\": \"Shade name or code\"\n        },\n        \"shadeColor\": {\n          \"type\": \"string\",\n          \"maxLength\": 20,\n          \"description\": \"Hex color code for shade swatch\"\n        },\n        \"shadeDescription\": {\n          \"type\": \"string\",\n          \"maxLength\": 200,\n          \"description\": \"Shade description\"\n        },\n        \"finish\": {\n          \"type\": \"string\",\n          \"maxLength\": 50,\n          \"description\": \"Finish: Dewy, Matte, Glow, Shimmer, Lash, Gloss\"\n        },\n        \"reference\": {\n          \"type\": \"string\",\n          \"maxLength\": 50,\n          \"description\": \"Batch code or reference\"\n        },\n        \"imageUrl\": {\n          \"type\": \"string\",\n          \"maxLength\": 2000,\n          \"description\": \"Product photograph URL\"\n        },\n        \"status\": {\n          \"type\": \"string\",\n          \"enum\": [\"en_uso\", \"nuevo\", \"agotado\", \"por_reponer\"],\n          \"description\": \"Usage status\"\n        },\n        \"size\": {\n          \"type\": \"string\",\n          \"maxLength\": 40,\n          \"description\": \"Volume or weight, e.g. 3.2 ml, 7.0 g\"\n        },\n        \"isFavorite\": {\n          \"type\": \"boolean\",\n          \"description\": \"Marked as favorite\"\n        },\n        \"isViralFavorite\": {\n          \"type\": \"boolean\",\n          \"description\": \"Badge for viral sensation\"\n        },\n        \"paoMonths\": {\n          \"type\": \"number\",\n          \"description\": \"Period after opening in months\"\n        },\n        \"purchaseDate\": {\n          \"type\": \"string\",\n          \"maxLength\": 50,\n          \"description\": \"Purchase date string\"\n        },\n        \"openedDate\": {\n          \"type\": \"string\",\n          \"maxLength\": 50,\n          \"description\": \"Opening date string\"\n        },\n        \"location\": {\n          \"type\": \"string\",\n          \"maxLength\": 100,\n          \"description\": \"Storage location in vanity\"\n        },\n        \"personalNotes\": {\n          \"type\": \"string\",\n          \"maxLength\": 1000,\n          \"description\": \"Personal review and application tips\"\n        },\n        \"createdAt\": {\n          \"type\": \"string\",\n          \"description\": \"Creation timestamp\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"description\": \"Update timestamp\"\n        }\n      },\n      \"required\": [\"id\", \"userId\", \"name\", \"brandName\", \"category\"]\n    },\n    \"UserProfile\": {\n      \"title\": \"UserProfile\",\n      \"description\": \"User vanity profile settings\",\n      \"type\": \"object\",\n      \"properties\": {\n        \"userId\": {\n          \"type\": \"string\",\n          \"description\": \"Firebase Auth user ID\"\n        },\n        \"displayName\": {\n          \"type\": \"string\",\n          \"maxLength\": 100,\n          \"description\": \"Display name\"\n        },\n        \"email\": {\n          \"type\": \"string\",\n          \"maxLength\": 150,\n          \"description\": \"User email\"\n        },\n        \"photoURL\": {\n          \"type\": \"string\",\n          \"maxLength\": 2000,\n          \"description\": \"Profile picture URL\"\n        },\n        \"updatedAt\": {\n          \"type\": \"string\",\n          \"description\": \"Update timestamp\"\n        }\n      },\n      \"required\": [\"userId\"]\n    }\n  },\n  \"firestore\": {\n    \"/brands/{brandId}\": {\n      \"schema\": \"Brand\",\n      \"description\": \"Brands registered by users\"\n    },\n    \"/products/{productId}\": {\n      \"schema\": \"Product\",\n      \"description\": \"Cosmetic items cataloged in user vanity\"\n    },\n    \"/userProfiles/{userId}\": {\n      \"schema\": \"UserProfile\",\n      \"description\": \"Profile info for the authenticated user\"\n    }\n  }\n}\n"
