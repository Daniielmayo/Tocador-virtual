  file_change {
    absolute_path_uri: "file:///src/components/ProductDetailModal.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { motion, AnimatePresence } from \'motion/react\';\nimport { Product, ProductStatus } from \'../types\';\nimport { useVanity } from \'../context/VanityContext\';\n\ninterface ProductDetailModalProps {\n  productId: string;\n  onClose: () => void;\n}\n\nexport const ProductDetailModal: React.FC<ProductDetailModalProps> = ({\n  productId,\n  onClose,\n}) => {\n  const {\n    products,\n    updateProduct,\n    deleteProduct,\n    toggleFavorite,\n    setEditingProduct,\n    setCurrentTab,\n    showToast,\n    user,\n  } = useVanity();\n\n  const product = products.find((p) => p.id === productId);\n\n  const [isEditingNotes, setIsEditingNotes] = useState(false);\n  const [notesText, setNotesText] = useState(product?.personalNotes || \'\');\n  const [showStatusMenu, setShowStatusMenu] = useState(false);\n  const [showLocationPrompt, setShowLocationPrompt] = useState(false);\n  const [newLocation, setNewLocation] = useState(product?.location || \'\');\n\n  if (!product) return null;\n\n  const handleStatusChange = async (newStatus: ProductStatus) => {\n    await updateProduct(product.id, { status: newStatus });\n    setShowStatusMenu(false);\n  };\n\n  const handleSaveNotes = async () => {\n    await updateProduct(product.id, { personalNotes: notesText });\n    setIsEditingNotes(false);\n  };\n\n  const handleSaveLocation = async () => {\n    if (newLocation.trim()) {\n      await updateProduct(product.id, { location: newLocation });\n    }\n    setShowLocationPrompt(false);\n  };\n\n  const handleShare = async () => {\n    if (navigator.share) {\n      try {\n        await navigator.share({\n          title: `${product.brandName} - ${product.name}`,\n          text: `Mira este producto en mi tocador Vanity: ${product.name} en tono ${product.shadeName}`,\n          url: window.location.href,\n        });\n      } catch {\n        // Ignored\n      }\n    } else {\n      navigator.clipboard?.writeText(\n        `${product.brandName} - ${product.name} (${product.shadeName})`\n      );\n      showToast(\'Enlace y detalles copiados al portapapeles\');\n    }\n  };\n\n  const handleDelete = () => {\n    if (confirm(`\302\277Deseas eliminar \"${product.name}\" de tu tocador?`)) {\n      deleteProduct(product.id);\n      onClose();\n    }\n  };\n\n  // PAO calculation\n  const paoMonths = product.paoMonths || 12;\n  const progressPercent = 75; // 75% optimal freshness indicator\n\n  return (\n    <motion.div\n      initial={{ opacity: 0 }}\n      animate={{ opacity: 1 }}\n      exit={{ opacity: 0 }}\n      className=\"fixed inset-0 z-50 bg-[#261819]/40 backdrop-blur-md flex justify-center overflow-y-auto\"\n    >\n      <motion.div\n        initial={{ y: \'100%\' }}\n        animate={{ y: 0 }}\n        exit={{ y: \'100%\' }}\n        transition={{ type: \'spring\', damping: 28, stiffness: 300 }}\n        className=\"w-full max-w-md bg-[#fff8f7] min-h-screen pb-20 shadow-2xl flex flex-col\"\n      >\n        {/* Header Superior del Detalle */}\n        <div className=\"sticky top-0 z-30 bg-[#fff8f7]/90 backdrop-blur-md border-b border-[#dac0c5]/25 px-4 h-16 flex items-center justify-between\">\n          <div className=\"flex items-center gap-3\">\n            <button\n              onClick={onClose}\n              className=\"w-10 h-10 -ml-2 rounded-full flex items-center justify-center text-[#554246] hover:text-[#9c385b] active:scale-95 transition-all\"\n            >\n              <span className=\"material-symbols-outlined text-[24px]\">arrow_back_ios_new</span>\n            </button>\n            <div className=\"flex items-center gap-2\">\n              <div className=\"w-7 h-7 rounded-md bg-[#261819] flex items-center justify-center text-[#d4a574]\">\n                <span className=\"font-headline font-bold text-[13px] italic\">V</span>\n              </div>\n              <span className=\"font-headline text-[18px] text-[#261819] font-medium\">\n                Detalle Producto\n              </span>\n            </div>\n          </div>\n\n          <div className=\"flex items-center gap-1.5\">\n            <button\n              onClick={handleShare}\n              className=\"w-9 h-9 rounded-full flex items-center justify-center text-[#554246] hover:bg-[#ffe9ea] active:scale-90 transition-all\"\n              title=\"Compartir tesoro\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">share</span>\n            </button>\n            <button\n              onClick={() => {\n                setEditingProduct(product);\n                setCurrentTab(\'anadir\');\n                onClose();\n              }}\n              className=\"w-9 h-9 rounded-full flex items-center justify-center text-[#554246] hover:bg-[#ffe9ea] active:scale-90 transition-all\"\n              title=\"Opciones\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">more_vert</span>\n            </button>\n            <div className=\"w-8 h-8 rounded-full overflow-hidden ml-1 ring-1 ring-[#79542b]/40\">\n              <img\n                src={\n                  user?.photoURL ||\n                  \'https://lh3.googleusercontent.com/aida-public/AB6AXuBqmhkchV3JUBDu8vFUodavOCCVHNymhhfU4aSG3QQOGXjE-8mwTcs8z0FOccTE4eeiyeBvRhqYigj5E8vMWMkOMhjUfeO12nEBW_Mh3FLufFy3_1idNvAmgowIiXULR73udPHz9dn3mpqGwfTJrQiLHqGgAWJc7HxbEMViD2g6mrnTj83s56T2cn7vEdADLuBLmIo-1rJgrAaXaM6J6ggw6Zu6d1bpA7cxfacYsbcM3b8lFCAeGzVrYA\'\n                }\n                alt=\"Usuario\"\n                className=\"w-full h-full object-cover\"\n                referrerPolicy=\"no-referrer\"\n              />\n            </div>\n          </div>\n        </div>\n\n        {/* Contenido Principal */}\n        <div className=\"px-4 py-4 space-y-5\">\n          {/* Badge Cat\303\241logo Personal */}\n          <div className=\"flex items-center gap-1.5 text-[11px] font-bold tracking-wider text-[#9c385b] uppercase\">\n            <span className=\"w-2 h-2 rounded-full bg-[#9c385b]\"></span>\n            <span>CAT\303\201LOGO PERSONAL</span>\n          </div>\n\n          {/* Gran Imagen Hero */}\n          <div className=\"relative w-full aspect-square rounded-3xl overflow-hidden bg-white shadow-md border border-[#dac0c5]/30\">\n            <img\n              src={product.imageUrl}\n              alt={product.name}\n              className=\"w-full h-full object-cover\"\n              referrerPolicy=\"no-referrer\"\n            />\n\n            {/* Dropdown de Estado (Top Left) */}\n            <div className=\"absolute top-3 left-3\">\n              <button\n                onClick={() => setShowStatusMenu(!showStatusMenu)}\n                className=\"flex items-center gap-1.5 py-1 px-3 rounded-full bg-white/95 backdrop-blur-md text-[#261819] text-[12px] font-bold shadow-sm active:scale-95 transition-all\"\n              >\n                <span\n                  className=\"w-2 h-2 rounded-full\"\n                  style={{\n                    backgroundColor:\n                      product.status === \'en_uso\'\n                        ? \'#fda7b0\'\n                        : product.status === \'nuevo\'\n                        ? \'#9c385b\'\n                        : \'#ba1a1a\',\n                  }}\n                ></span>\n                <span>\n                  {product.status === \'en_uso\'\n                    ? \'En uso\'\n                    : product.status === \'nuevo\'\n                    ? \'Nuevo\'\n                    : \'Agotado\'}\n                </span>\n                <span className=\"material-symbols-outlined text-[16px] text-[#877176]\">\n                  expand_more\n                </span>\n              </button>\n\n              {showStatusMenu && (\n                <div className=\"absolute top-full left-0 mt-1.5 w-32 bg-white rounded-2xl shadow-xl border border-[#dac0c5]/30 z-40 p-1 flex flex-col gap-1\">\n                  {[\n                    { id: \'en_uso\' as ProductStatus, label: \'En uso\' },\n                    { id: \'nuevo\' as ProductStatus, label: \'Nuevo\' },\n                    { id: \'agotado\' as ProductStatus, label: \'Agotado\' },\n                  ].map((s) => (\n                    <button\n                      key={s.id}\n                      onClick={() => handleStatusChange(s.id)}\n                      className={`px-3 py-1.5 text-left text-[12px] rounded-xl font-medium ${\n                        product.status === s.id\n                          ? \'bg-[#9c385b] text-white\'\n                          : \'hover:bg-[#ffe9ea] text-[#261819]\'\n                      }`}\n                    >\n                      {s.label}\n                    </button>\n                  ))}\n                </div>\n              )}\n            </div>\n\n            {/* Badge de Acabado (Bottom Right) */}\n            <div className=\"absolute bottom-3 right-3 py-1 px-3 rounded-full bg-[#261819]/80 backdrop-blur-md text-white text-[11px] font-semibold flex items-center gap-1 shadow-md\">\n              <span className=\"text-[#d4a574] text-xs\">\342\234\250</span>\n              <span>{product.finish || \'Dewy\'} Finish</span>\n            </div>\n          </div>\n\n          {/* Marca, Referencia & T\303\255tulo */}\n          <div className=\"flex flex-col gap-1\">\n            <div className=\"flex items-center justify-between\">\n              <span className=\"text-[12px] font-bold text-[#79542b] uppercase tracking-wider flex items-center gap-1 cursor-pointer hover:underline\">\n                <span>{product.brandName}</span>\n                <span className=\"material-symbols-outlined text-[14px]\">arrow_forward</span>\n              </span>\n              <span className=\"text-[12px] text-[#877176] font-medium\">\n                Lote: {product.reference}\n              </span>\n            </div>\n\n            <h1 className=\"font-headline text-[30px] font-semibold text-[#261819] leading-tight\">\n              {product.name}\n            </h1>\n          </div>\n\n          {/* Secci\303\263n de Tono y Muestrario Swatch */}\n          <div className=\"p-3.5 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm space-y-3\">\n            <div className=\"flex items-center justify-between\">\n              <div className=\"flex items-center gap-3\">\n                <div\n                  className=\"w-8 h-8 rounded-full shadow-inner border-2 border-white ring-1 ring-[#dac0c5]\"\n                  style={{ backgroundColor: product.shadeColor }}\n                ></div>\n                <div className=\"flex flex-col\">\n                  <div className=\"flex items-center gap-1.5\">\n                    <span className=\"font-bold text-[14px] text-[#261819]\">\n                      Tono: {product.shadeName.replace(/#\\d+\\s*\342\200\242?\\s*/, \'\')}\n                    </span>\n                  </div>\n                  <span className=\"text-[12px] text-[#554246]\">\n                    {product.shadeDescription || `${product.finish} Finish Radiante`}\n                  </span>\n                </div>\n              </div>\n\n              {product.isViralFavorite && (\n                <span className=\"py-1 px-2.5 rounded-full bg-[#fee1e4] text-[#9c385b] text-[10px] font-bold tracking-wider uppercase\">\n                  FAVORITO VIRAL\n                </span>\n              )}\n            </div>\n\n            {/* Tonos en tocador */}\n            <div className=\"flex items-center gap-2 pt-1 border-t border-[#dac0c5]/20\">\n              <span className=\"text-[11px] text-[#554246] font-medium\">Tonos en tocador:</span>\n              <div className=\"flex items-center gap-1.5\">\n                {[\n                  product.shadeColor,\n                  \'#DE8C8C\',\n                  \'#BA6D75\',\n                  \'#E07C64\',\n                ].map((color, idx) => (\n                  <span\n                    key={idx}\n                    className=\"w-5 h-5 rounded-full border border-white shadow-sm cursor-pointer hover:scale-110 transition-transform\"\n                    style={{ backgroundColor: color }}\n                    title=\"Muestra de tono en stock\"\n                  ></span>\n                ))}\n              </div>\n            </div>\n          </div>\n\n          {/* Bot\303\263n Favoritos del Tocador */}\n          <button\n            onClick={() => toggleFavorite(product.id)}\n            className={`w-full h-12 rounded-full font-bold text-[14px] flex items-center justify-center gap-2 transition-all shadow-sm active:scale-95 ${\n              product.isFavorite\n                ? \'bg-[#fda7b0] text-[#3a0813] hover:bg-[#f895a0]\'\n                : \'bg-[#fee1e4] text-[#9c385b] hover:bg-[#f8dcde]\'\n            }`}\n          >\n            <span\n              className=\"material-symbols-outlined text-[20px]\"\n              style={{\n                fontVariationSettings: product.isFavorite ? \"\'FILL\' 1\" : \"\'FILL\' 0\",\n              }}\n            >\n              favorite\n            </span>\n            <span>\n              {product.isFavorite\n                ? \'En mis favoritos del tocador\'\n                : \'A\303\261adir a mis favoritos\'}\n            </span>\n          </button>\n\n          {/* Bloque: Detalles del Cosm\303\251tico */}\n          <div className=\"space-y-3\">\n            <div className=\"flex items-center justify-between px-1\">\n              <h2 className=\"font-headline text-[19px] font-semibold text-[#261819]\">\n                Detalles del Cosm\303\251tico\n              </h2>\n              <span className=\"material-symbols-outlined text-[#79542b] text-[20px]\">\n                spa\n              </span>\n            </div>\n\n            {/* Grid 2 Columnas de Info */}\n            <div className=\"grid grid-cols-2 gap-3\">\n              <div className=\"p-3.5 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n                <div className=\"flex items-center gap-1 text-[#9c385b] text-[11px] font-bold uppercase\">\n                  <span className=\"material-symbols-outlined text-[16px]\">edit</span>\n                  <span>CATEGOR\303\215A</span>\n                </div>\n                <span className=\"font-bold text-[14px] text-[#261819]\">\n                  {product.subCategory || product.category}\n                </span>\n                <span className=\"text-[11px] text-[#554246]\">Rostro / Color</span>\n              </div>\n\n              <div className=\"p-3.5 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex flex-col gap-1\">\n                <div className=\"flex items-center gap-1 text-[#9c385b] text-[11px] font-bold uppercase\">\n                  <span className=\"material-symbols-outlined text-[16px]\">calendar_today</span>\n                  <span>COMPRADO</span>\n                </div>\n                <span className=\"font-bold text-[14px] text-[#261819]\">\n                  {product.purchaseDate}\n                </span>\n                <span className=\"text-[11px] text-[#554246]\">Activo y vigente</span>\n              </div>\n            </div>\n\n            {/* Tarjeta PAO (Period After Opening) */}\n            <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm space-y-2\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-2\">\n                  <span className=\"material-symbols-outlined text-[#9c385b] text-[20px]\">\n                    hourglass_bottom\n                  </span>\n                  <div className=\"flex flex-col\">\n                    <span className=\"font-bold text-[13.5px] text-[#261819]\">\n                      PAO: {paoMonths}M tras apertura\n                    </span>\n                    <span className=\"text-[11.5px] text-[#554246]\">\n                      9 meses de frescura restantes\n                    </span>\n                  </div>\n                </div>\n                <span className=\"py-1 px-2.5 rounded-full bg-[#fee1e4] text-[#9c385b] text-[11px] font-bold\">\n                  {progressPercent}% \303\223ptimo\n                </span>\n              </div>\n\n              {/* Barra de Progreso de Frescura */}\n              <div className=\"w-full h-2 bg-[#fee1e4] rounded-full overflow-hidden\">\n                <div\n                  className=\"h-full bg-gradient-to-r from-[#79542b] to-[#9c385b] rounded-full\"\n                  style={{ width: `${progressPercent}%` }}\n                ></div>\n              </div>\n            </div>\n\n            {/* Tarjeta Ubicaci\303\263n en Tocador */}\n            <div className=\"p-3.5 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm flex items-center justify-between\">\n              <div className=\"flex items-center gap-2.5\">\n                <div className=\"w-9 h-9 rounded-xl bg-[#ffe9ea] text-[#9c385b] flex items-center justify-center\">\n                  <span className=\"material-symbols-outlined text-[20px]\">meeting_room</span>\n                </div>\n                <div className=\"flex flex-col\">\n                  <span className=\"text-[10.5px] uppercase font-bold text-[#877176]\">\n                    UBICACI\303\223N\n                  </span>\n                  <span className=\"font-semibold text-[13px] text-[#261819]\">\n                    {product.location}\n                  </span>\n                </div>\n              </div>\n\n              <button\n                onClick={() => setShowLocationPrompt(!showLocationPrompt)}\n                className=\"text-[#79542b] font-bold text-[12px] hover:underline\"\n              >\n                Cambiar\n              </button>\n            </div>\n\n            {showLocationPrompt && (\n              <div className=\"p-3 rounded-2xl bg-[#fee1e4]/50 border border-[#dac0c5]/30 flex items-center gap-2\">\n                <input\n                  value={newLocation}\n                  onChange={(e) => setNewLocation(e.target.value)}\n                  placeholder=\"Ej. Caj\303\263n superior, Bandeja central...\"\n                  className=\"flex-1 px-3 py-1.5 rounded-xl bg-white text-[13px] border border-[#dac0c5]/40 outline-none\"\n                />\n                <button\n                  onClick={handleSaveLocation}\n                  className=\"px-3 py-1.5 rounded-xl bg-[#9c385b] text-white text-[12px] font-bold\"\n                >\n                  Guardar\n                </button>\n              </div>\n            )}\n\n            {/* Tarjeta Mis Notas Personales */}\n            <div className=\"p-4 rounded-2xl bg-white border border-[#dac0c5]/25 shadow-sm space-y-1.5\">\n              <div className=\"flex items-center justify-between\">\n                <div className=\"flex items-center gap-1.5 text-[#554246]\">\n                  <span className=\"material-symbols-outlined text-[18px]\">edit_note</span>\n                  <span className=\"text-[11px] font-bold uppercase tracking-wider\">\n                    MIS NOTAS PERSONALES\n                  </span>\n                </div>\n                <button\n                  onClick={() => setIsEditingNotes(!isEditingNotes)}\n                  className=\"text-[#9c385b] font-bold text-[12px] hover:underline\"\n                >\n                  {isEditingNotes ? \'Cerrar\' : \'Editar\'}\n                </button>\n              </div>\n\n              {isEditingNotes ? (\n                <div className=\"space-y-2 pt-1\">\n                  <textarea\n                    value={notesText}\n                    onChange={(e) => setNotesText(e.target.value)}\n                    rows={3}\n                    className=\"w-full p-2.5 rounded-xl bg-[#fff8f7] border border-[#dac0c5]/40 text-[13px] text-[#261819] outline-none\"\n                    placeholder=\"Escribe tus impresiones sobre pigmentaci\303\263n, duraci\303\263n y trucos...\"\n                  ></textarea>\n                  <button\n                    onClick={handleSaveNotes}\n                    className=\"py-1.5 px-4 rounded-full bg-[#9c385b] text-white text-[12px] font-bold active:scale-95\"\n                  >\n                    Guardar Notas\n                  </button>\n                </div>\n              ) : (\n                <p className=\"text-[13px] text-[#554246] italic leading-relaxed\">\n                  \"{product.personalNotes || \'Sin notas registradas a\303\272n.\'}\"\n                </p>\n              )}\n            </div>\n          </div>\n\n          {/* Botones de Acci\303\263n Finales */}\n          <div className=\"pt-2 space-y-2.5\">\n            <button\n              onClick={() => {\n                setEditingProduct(product);\n                setCurrentTab(\'anadir\');\n                onClose();\n              }}\n              className=\"w-full h-12 rounded-2xl bg-[#9c385b] hover:bg-[#852a4a] text-white font-bold text-[14px] flex items-center justify-center gap-2 shadow-sm active:scale-95 transition-all\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">tune</span>\n              <span>Editar detalles del producto</span>\n            </button>\n\n            <button\n              onClick={handleDelete}\n              className=\"w-full h-12 rounded-2xl bg-[#fee1e4] hover:bg-[#f8dcde] text-[#ba1a1a] font-bold text-[14px] flex items-center justify-center gap-2 shadow-sm active:scale-95 transition-all\"\n            >\n              <span className=\"material-symbols-outlined text-[20px]\">delete_outline</span>\n              <span>Eliminar de mi tocador</span>\n            </button>\n          </div>\n        </div>\n      </motion.div>\n    </motion.div>\n  );\n};\n"
    }
